<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
	<TemplateGroupID>CSharp</TemplateGroupID>
    <Name>TemplatePlugin</Name>
    <Description>Day2eEditor Plugin Template</Description>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>TemplatePlugin</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="TemplatePlugin.csproj" File="TemplatePlugin.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="RenameMeForm.cs">RenameMeForm.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="RenameMeForm.Designer.cs">RenameMeForm.Designer.cs</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="RenameMeForm.resx">RenameMeForm.resx</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>